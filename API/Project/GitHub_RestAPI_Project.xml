<?xml version="1.0" encoding="UTF-8"?>
<con:soapui-project xmlns:con="http://eviware.com/soapui/config" id="GitHub_RestAPI_Project"
                    activeEnvironment="Default"
                    name="GitHub_RestAPI_Project"
                    soapui-version="5.7.0"
                    abortOnError="false"
                    runType="SEQUENTIAL">
  <con:settings/>
  <con:interface xsi:type="con:RestService" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="GitHub_REST_Service"
                 name="GitHub REST API"
                 type="rest"
                 wadlVersion="http://wadl.dev.java.net/2009/02">
    <con:settings/>
    <con:definitionCache/>
    <con:endpoints>
      <con:endpoint>https://api.github.com</con:endpoint>
    </con:endpoints>

    <con:resource name="User SSH Keys" path="/user/keys" id="GitHub_User_Keys">
      <con:settings/>

      <con:method name="POST Create SSH Key" id="POST_Create_Key" method="POST">
        <con:settings/>
        <con:parameters/>
        <con:representation type="REQUEST">
          <con:mediaType>application/json</con:mediaType>
          <con:params/>
        </con:representation>
        <con:request>
          <con:settings/>
          <con:endpoint>https://api.github.com</con:endpoint>
          <con:resourcePath>/user/keys</con:resourcePath>
          <con:parameters/>
          <con:parameterOrder/>
          <con:requestHeaders>
            <con:entry key="Authorization" value="Bearer ${#Project#GITHUB_TOKEN}"/>
            <con:entry key="Accept" value="application/vnd.github+json"/>
            <con:entry key="Content-Type" value="application/json"/>
            <con:entry key="X-GitHub-Api-Version" value="2022-11-28"/>
          </con:requestHeaders>
          <con:requestContent>{
  "title": "TestKey",
  "key": "ssh-ed25519 AAAA_REPLACE_WITH_YOUR_PUBLIC_SSH_KEY"
}</con:requestContent>
        </con:request>
      </con:method>

      <con:method name="GET SSH Key" id="GET_Key" method="GET">
        <con:settings/>
        <con:parameters>
          <con:parameter>
            <con:name>keyId</con:name>
            <con:value>${#TestCase#keyId}</con:value>
            <con:style>TEMPLATE</con:style>
            <con:declared>true</con:declared>
          </con:parameter>
        </con:parameters>
        <con:representation type="REQUEST">
          <con:mediaType>application/json</con:mediaType>
          <con:params/>
        </con:representation>
        <con:request>
          <con:settings/>
          <con:endpoint>https://api.github.com</con:endpoint>
          <con:resourcePath>/user/keys/{keyId}</con:resourcePath>
          <con:parameters>
            <con:entry key="keyId" value="${#TestCase#keyId}"/>
          </con:parameters>
          <con:parameterOrder>
            <con:entry>keyId</con:entry>
          </con:parameterOrder>
          <con:requestHeaders>
            <con:entry key="Authorization" value="Bearer ${#Project#GITHUB_TOKEN}"/>
            <con:entry key="Accept" value="application/vnd.github+json"/>
            <con:entry key="X-GitHub-Api-Version" value="2022-11-28"/>
          </con:requestHeaders>
        </con:request>
      </con:method>

      <con:method name="DELETE SSH Key" id="DELETE_Key" method="DELETE">
        <con:settings/>
        <con:parameters>
          <con:parameter>
            <con:name>keyId</con:name>
            <con:value>${#TestCase#keyId}</con:value>
            <con:style>TEMPLATE</con:style>
            <con:declared>true</con:declared>
          </con:parameter>
        </con:parameters>
        <con:representation type="REQUEST">
          <con:mediaType>application/json</con:mediaType>
          <con:params/>
        </con:representation>
        <con:request>
          <con:settings/>
          <con:endpoint>https://api.github.com</con:endpoint>
          <con:resourcePath>/user/keys/{keyId}</con:resourcePath>
          <con:parameters>
            <con:entry key="keyId" value="${#TestCase#keyId}"/>
          </con:parameters>
          <con:parameterOrder>
            <con:entry>keyId</con:entry>
          </con:parameterOrder>
          <con:requestHeaders>
            <con:entry key="Authorization" value="Bearer ${#Project#GITHUB_TOKEN}"/>
            <con:entry key="Accept" value="application/vnd.github+json"/>
            <con:entry key="X-GitHub-Api-Version" value="2022-11-28"/>
          </con:requestHeaders>
        </con:request>
      </con:method>
    </con:resource>
  </con:interface>

  <con:testSuite id="GitHub_TestSuite" name="GitHub SSH Key Test Suite">
    <con:settings/>
    <con:runType>SEQUENTIAL</con:runType>
    <con:testCase id="GitHub_TestCase" name="Create Get Delete SSH Key" failOnError="true" failTestCaseOnErrors="true" keepSession="false">
      <con:settings/>
      <con:testStep type="restrequest" name="POST - Create SSH Key" id="Step_POST">
        <con:settings/>
        <con:config xsi:type="con:RestTestRequestStep"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    testCase="GitHub_TestCase"
                    testRequest="POST Create SSH Key">
          <con:restRequest name="POST - Create SSH Key">
            <con:settings/>
            <con:request>
              <con:settings/>
              <con:endpoint>https://api.github.com</con:endpoint>
              <con:resourcePath>/user/keys</con:resourcePath>
              <con:requestHeaders>
                <con:entry key="Authorization" value="Bearer ${#Project#GITHUB_TOKEN}"/>
                <con:entry key="Accept" value="application/vnd.github+json"/>
                <con:entry key="Content-Type" value="application/json"/>
                <con:entry key="X-GitHub-Api-Version" value="2022-11-28"/>
              </con:requestHeaders>
              <con:requestContent>{
  "title": "TestKey",
  "key": "ssh-ed25519 AAAA_REPLACE_WITH_YOUR_PUBLIC_SSH_KEY"
}</con:requestContent>
            </con:request>
            <con:assertions>
              <con:assertion type="Valid HTTP Status Codes" name="Status Code 201">
                <con:configuration>
                  <codes>201</codes>
                </con:configuration>
              </con:assertion>
            </con:assertions>
          </con:restRequest>
        </con:config>
      </con:testStep>

      <con:testStep type="groovy" name="Extract Key ID" id="Step_Extract_ID">
        <con:settings/>
        <con:config xsi:type="con:GroovyScriptStep" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
          <con:script><![CDATA[
def response = testRunner.testCase.testSteps["POST - Create SSH Key"].testRequest.response
def json = new groovy.json.JsonSlurper().parseText(response.responseContent)
def keyId = json.id.toString()
testRunner.testCase.setPropertyValue("keyId", keyId)
log.info "Created GitHub SSH key ID: " + keyId
          ]]></con:script>
        </con:config>
      </con:testStep>

      <con:testStep type="restrequest" name="GET - Get SSH Key" id="Step_GET">
        <con:settings/>
        <con:config xsi:type="con:RestTestRequestStep" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    testCase="GitHub_TestCase"
                    testRequest="GET SSH Key">
          <con:restRequest name="GET - Get SSH Key">
            <con:settings/>
            <con:request>
              <con:settings/>
              <con:endpoint>https://api.github.com</con:endpoint>
              <con:resourcePath>/user/keys/${#TestCase#keyId}</con:resourcePath>
              <con:requestHeaders>
                <con:entry key="Authorization" value="Bearer ${#Project#GITHUB_TOKEN}"/>
                <con:entry key="Accept" value="application/vnd.github+json"/>
                <con:entry key="X-GitHub-Api-Version" value="2022-11-28"/>
              </con:requestHeaders>
            </con:request>
            <con:assertions>
              <con:assertion type="Valid HTTP Status Codes" name="Status Code 200">
                <con:configuration>
                  <codes>200</codes>
                </con:configuration>
              </con:assertion>
            </con:assertions>
          </con:restRequest>
        </con:config>
      </con:testStep>

      <con:testStep type="restrequest" name="DELETE - Delete SSH Key" id="Step_DELETE">
        <con:settings/>
        <con:config xsi:type="con:RestTestRequestStep" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    testCase="GitHub_TestCase"
                    testRequest="DELETE SSH Key">
          <con:restRequest name="DELETE - Delete SSH Key">
            <con:settings/>
            <con:request>
              <con:settings/>
              <con:endpoint>https://api.github.com</con:endpoint>
              <con:resourcePath>/user/keys/${#TestCase#keyId}</con:resourcePath>
              <con:requestHeaders>
                <con:entry key="Authorization" value="Bearer ${#Project#GITHUB_TOKEN}"/>
                <con:entry key="Accept" value="application/vnd.github+json"/>
                <con:entry key="X-GitHub-Api-Version" value="2022-11-28"/>
              </con:requestHeaders>
            </con:request>
            <con:assertions>
              <con:assertion type="Valid HTTP Status Codes" name="Status Code 204">
                <con:configuration>
                  <codes>204</codes>
                </con:configuration>
              </con:assertion>
            </con:assertions>
          </con:restRequest>
        </con:config>
      </con:testStep>
    </con:testCase>
  </con:testSuite>

  <con:properties>
    <con:property>
      <con:name>GITHUB_TOKEN</con:name>
      <con:value>REPLACE_WITH_YOUR_GITHUB_TOKEN</con:value>
    </con:property>
  </con:properties>
</con:soapui-project>
