<?xml version="1.0" encoding="UTF-8"?>
<con:soapui-project xmlns:con="http://eviware.com/soapui/config"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Activity5" name="Activity5" soapui-version="5.7.0">

  <con:interface xsi:type="con:RestService" id="ipwhois-rest"
      name="IPWhois REST API" type="rest">
    <con:settings/>
    <con:restMethod id="ipwhois-json" name="IPWhois JSON" method="GET">
      <con:settings/>
      <con:parameters>
        <con:parameter>
          <con:name>IP</con:name>
          <con:value>${DataSource#IP_Address}</con:value>
          <con:style>TEMPLATE</con:style>
          <con:default>164.172.55.44</con:default>
          <con:description>IP address supplied by the Excel DataSource.</con:description>
        </con:parameter>
      </con:parameters>
      <con:request name="Request 1">
        <con:settings/>
        <con:endpoint>http://ipwhois.app/json/{IP}</con:endpoint>
        <con:request/>
        <con:originalUri>http://ipwhois.app/json/{IP}</con:originalUri>
      </con:request>
    </con:restMethod>
  </con:interface>

  <con:testSuite id="Activity5Suite" name="Activity5">
    <con:description>Activity 5 - Excel DataSource driven IPWhois REST API test</con:description>

    <con:testCase id="Activity5TestCase" name="IPWhois Excel Data Driven Test" searchProperties="true">
      <con:description>
        Reads IP addresses from an Excel DataSource, sends the IPWhois request for each row,
        and validates that the country node exists in the JSON response.
      </con:description>

      <con:testStep type="datasource" name="DataSource" id="Activity5DataSource">
        <con:settings/>
        <con:config xsi:type="con:DataSourceStep">
          <con:dataSource type="Excel">
            <con:property name="IP_Address"/>
            <con:configuration>
              <con:filePath>activity5_ip_addresses.xlsx</con:filePath>
              <con:worksheet>IP Addresses</con:worksheet>
              <con:startRow>1</con:startRow>
              <con:endRow>0</con:endRow>
              <con:firstRowIsHeader>true</con:firstRowIsHeader>
            </con:configuration>
          </con:dataSource>
        </con:config>
      </con:testStep>

      <con:testStep type="restrequest" name="Request 1" id="Activity5Request">
        <con:settings/>
        <con:restRequest service="IPWhois REST API" resource="IPWhois JSON" method="IPWhois JSON">
          <con:settings/>
          <con:endpoint>http://ipwhois.app/json/${DataSource#IP_Address}</con:endpoint>
          <con:request/>
          <con:assertion type="JsonPath Match"
              id="Activity5CountryAssertion"
              name="JSONPath Match - country">
            <con:configuration>
              <JsonPathMatchAssertion>
                <path>$.country</path>
                <content>.*</content>
                <allowWildcards>true</allowWildcards>
                <ignoreXmlSchemaCompliance>false</ignoreXmlSchemaCompliance>
                <regEx>true</regEx>
                <count>1</count>
              </JsonPathMatchAssertion>
            </con:configuration>
          </con:assertion>
        </con:restRequest>
      </con:testStep>

      <con:testStep type="datasourceloop" name="DataSource Loop" id="Activity5Loop">
        <con:settings/>
        <con:config>
          <con:dataSourceStep>DataSource</con:dataSourceStep>
          <con:testStep>Request 1</con:testStep>
          <con:restartLoop>false</con:restartLoop>
        </con:config>
      </con:testStep>

      <con:loadTest type="http" name="LoadTest"/>
    </con:testCase>
  </con:testSuite>

  <con:properties/>
  <con:wssContainer/>
  <con:oAuth2ProfileContainer/>
  <con:oAuth1ProfileContainer/>
  <con:reporting/>
</con:soapui-project>
