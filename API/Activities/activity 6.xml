<?xml version="1.0" encoding="UTF-8"?>
<con:soapui-project xmlns:con="http://eviware.com/soapui/config"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Activity6" name="Activity6" soapui-version="5.7.0">

  <con:interface xsi:type="con:RestService" id="ipwhois-rest"
      name="IPWhois REST API" type="rest">
    <con:settings/>
    <con:restMethod id="ipwhois-json" name="IPWhois JSON" method="GET">
      <con:settings/>
      <con:parameters>
        <con:parameter>
          <con:name>IP</con:name>
          <con:value>${DataSource#address}</con:value>
          <con:style>TEMPLATE</con:style>
          <con:default>127.0.0.1</con:default>
          <con:description>IP address generated by the Computer Address DataSource.</con:description>
        </con:parameter>
      </con:parameters>
      <con:request name="Request">
        <con:settings/>
        <con:endpoint>http://ipwhois.app/json/{IP}</con:endpoint>
        <con:request/>
        <con:originalUri>http://ipwhois.app/json/{IP}</con:originalUri>
      </con:request>
    </con:restMethod>
  </con:interface>

  <con:testSuite id="Activity6Suite" name="Activity6">
    <con:description>
      Activity 6 - Generate random computer IP addresses, query IPWhois,
      validate city, and transfer city/latitude/longitude values to a JDBC DataSink.
    </con:description>

    <con:testCase id="Activity6TestCase" name="IPWhois JDBC DataSink Test" searchProperties="true">
      <con:description>
        The DataSource generates random computer addresses. The REST request uses
        ${DataSource#address}. A JSONPath assertion validates $.city.
        Property transfers populate JDBC DataSink properties for city, latitude, and longitude.
      </con:description>

      <con:testStep type="datasource" name="DataSource" id="Activity6DataSource">
        <con:settings/>
        <con:config xsi:type="con:DataSourceStep">
          <con:dataSource type="PROPERTY">
            <con:property name="address"/>
            <con:configuration>
              <con:propertyType>Computer Address</con:propertyType>
              <con:generateRandom>true</con:generateRandom>
            </con:configuration>
          </con:dataSource>
        </con:config>
      </con:testStep>

      <con:testStep type="restrequest" name="Request" id="Activity6Request">
        <con:settings/>
        <con:restRequest service="IPWhois REST API" resource="IPWhois JSON" method="IPWhois JSON">
          <con:settings/>
          <con:endpoint>http://ipwhois.app/json/${DataSource#address}</con:endpoint>
          <con:request/>
          <con:assertion type="JsonPath Match"
              id="Activity6CityAssertion"
              name="JSONPath Match - city">
            <con:configuration>
              <JsonPathMatchAssertion>
                <path>$['city']</path>
                <content>.*</content>
                <allowWildcards>true</allowWildcards>
                <ignoreXmlSchemaCompliance>false</ignoreXmlSchemaCompliance>
                <regEx>true</regEx>
                <count>1</count>
              </JsonPathMatchAssertion>
            </con:configuration>
          </con:assertion>
        </con:restRequest>
      </con:testStep>

      <con:testStep type="datasink" name="DataSink" id="Activity6DataSink">
        <con:settings/>
        <con:config xsi:type="con:DataSinkStep">
          <con:dataSink type="JDBC">
            <con:configuration>
              <con:driver>com.mysql.cj.jdbc.Driver</con:driver>
              <con:connectionString>jdbc:mysql://localhost:3306/your_database</con:connectionString>
              <con:username>YOUR_USERNAME</con:username>
              <con:password>YOUR_PASSWORD</con:password>
              <con:table>coordinates</con:table>
              <con:query>
                INSERT INTO coordinates (city, latitude, longitude)
                VALUES (${DataSink#city}, ${DataSink#latitude}, ${DataSink#longitude})
              </con:query>
            </con:configuration>
            <con:property name="city"/>
            <con:property name="latitude"/>
            <con:property name="longitude"/>
          </con:dataSink>
        </con:config>
      </con:testStep>

      <con:testStep type="propertytransfer" name="Property Transfer" id="Activity6PropertyTransfer">
        <con:settings/>
        <con:config>
          <con:transfer name="City">
            <con:sourceStep>Request</con:sourceStep>
            <con:sourceType>JSONPath</con:sourceType>
            <con:sourceProperty>$['city']</con:sourceProperty>
            <con:targetStep>DataSink</con:targetStep>
            <con:targetProperty>city</con:targetProperty>
          </con:transfer>
          <con:transfer name="Latitude">
            <con:sourceStep>Request</con:sourceStep>
            <con:sourceType>JSONPath</con:sourceType>
            <con:sourceProperty>$['latitude']</con:sourceProperty>
            <con:targetStep>DataSink</con:targetStep>
            <con:targetProperty>latitude</con:targetProperty>
          </con:transfer>
          <con:transfer name="Longitude">
            <con:sourceStep>Request</con:sourceStep>
            <con:sourceType>JSONPath</con:sourceType>
            <con:sourceProperty>$['longitude']</con:sourceProperty>
            <con:targetStep>DataSink</con:targetStep>
            <con:targetProperty>longitude</con:targetProperty>
          </con:transfer>
        </con:config>
      </con:testStep>

      <con:testStep type="datasourceloop" name="DataSource Loop" id="Activity6Loop">
        <con:settings/>
        <con:config>
          <con:dataSourceStep>DataSource</con:dataSourceStep>
          <con:testStep>Request</con:testStep>
          <con:restartLoop>false</con:restartLoop>
        </con:config>
      </con:testStep>

      <con:loadTest type="http" name="LoadTest"/>
    </con:testCase>
  </con:testSuite>

  <con:properties/>
  <con:wssContainer/>
  <con:oAuth2ProfileContainer/>
  <con:oAuth1ProfileContainer/>
  <con:reporting/>
</con:soapui-project>
