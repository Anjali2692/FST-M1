<?xml version="1.0" encoding="UTF-8"?>
<con:soapui-project xmlns:con="http://eviware.com/soapui/config"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    id="Petstore_REST_Project"
                    name="Petstore_REST_Project"
                    soapui-version="5.7.0"
                    abortOnError="false"
                    runType="SEQUENTIAL">

  <con:settings/>

  <con:interface xsi:type="con:RestService"
                 id="Petstore_REST_Service"
                 name="Swagger Petstore REST API"
                 type="rest">

    <con:settings/>

    <con:endpoints>
      <con:endpoint>https://petstore.swagger.io/v2</con:endpoint>
    </con:endpoints>

    <con:resource name="User" path="/user" id="User_Resource">
      <con:settings/>

      <con:method name="Create User" id="Create_User" method="POST">
        <con:settings/>
        <con:parameters/>
        <con:representation type="REQUEST">
          <con:mediaType>application/json</con:mediaType>
        </con:representation>

        <con:request>
          <con:settings/>
          <con:endpoint>https://petstore.swagger.io/v2</con:endpoint>
          <con:resourcePath>/user</con:resourcePath>
          <con:parameters/>
          <con:requestHeaders>
            <con:entry key="Accept" value="application/json"/>
            <con:entry key="Content-Type" value="application/json"/>
          </con:requestHeaders>

          <con:requestContent>{
  "id": 10,
  "username": "testuser",
  "firstName": "Test",
  "lastName": "User",
  "email": "testuser@example.com",
  "password": "password123",
  "phone": "9876543210",
  "userStatus": 1
}</con:requestContent>
        </con:request>
      </con:method>
    </con:resource>

    <con:resource name="User By Username" path="/user/{username}" id="User_By_Username">
      <con:settings/>

      <con:method name="Get User" id="Get_User" method="GET">
        <con:settings/>

        <con:parameters>
          <con:parameter>
            <con:name>username</con:name>
            <con:value>testuser</con:value>
            <con:style>TEMPLATE</con:style>
            <con:declared>true</con:declared>
          </con:parameter>
        </con:parameters>

        <con:representation type="REQUEST">
          <con:mediaType>application/json</con:mediaType>
        </con:representation>

        <con:request>
          <con:settings/>
          <con:endpoint>https://petstore.swagger.io/v2</con:endpoint>
          <con:resourcePath>/user/{username}</con:resourcePath>
          <con:parameters>
            <con:entry key="username" value="testuser"/>
          </con:parameters>
          <con:requestHeaders>
            <con:entry key="Accept" value="application/json"/>
          </con:requestHeaders>
        </con:request>
      </con:method>
    </con:resource>

    <con:resource name="Login" path="/user/login" id="Login_Resource">
      <con:settings/>

      <con:method name="Login User" id="Login_User" method="GET">
        <con:settings/>

        <con:parameters>
          <con:parameter>
            <con:name>username</con:name>
            <con:value>testuser</con:value>
            <con:style>QUERY</con:style>
            <con:declared>true</con:declared>
          </con:parameter>
          <con:parameter>
            <con:name>password</con:name>
            <con:value>password123</con:value>
            <con:style>QUERY</con:style>
            <con:declared>true</con:declared>
          </con:parameter>
        </con:parameters>

        <con:representation type="REQUEST">
          <con:mediaType>application/json</con:mediaType>
        </con:representation>

        <con:request>
          <con:settings/>
          <con:endpoint>https://petstore.swagger.io/v2</con:endpoint>
          <con:resourcePath>/user/login</con:resourcePath>
          <con:parameters>
            <con:entry key="username" value="testuser"/>
            <con:entry key="password" value="password123"/>
          </con:parameters>
          <con:requestHeaders>
            <con:entry key="Accept" value="application/json"/>
          </con:requestHeaders>
        </con:request>
      </con:method>
    </con:resource>

  </con:interface>

  <con:testSuite id="Petstore_TestSuite" name="Petstore User Test Suite">
    <con:settings/>
    <con:runType>SEQUENTIAL</con:runType>

    <con:testCase id="Petstore_User_TestCase"
                  name="Create Get Login User"
                  failOnError="true"
                  failTestCaseOnErrors="true"
                  keepSession="false">

      <con:settings/>

      <con:testStep type="restrequest"
                    name="POST - Create User"
                    id="Step_Create_User">

        <con:settings/>

        <con:config xsi:type="con:RestTestRequestStep"
                    testCase="Petstore_User_TestCase"
                    testRequest="Create User">

          <con:restRequest name="POST - Create User">

            <con:settings/>

            <con:request>
              <con:settings/>
              <con:endpoint>https://petstore.swagger.io/v2</con:endpoint>
              <con:resourcePath>/user</con:resourcePath>

              <con:requestHeaders>
                <con:entry key="Accept" value="application/json"/>
                <con:entry key="Content-Type" value="application/json"/>
              </con:requestHeaders>

              <con:requestContent>{
  "id": 10,
  "username": "testuser",
  "firstName": "Test",
  "lastName": "User",
  "email": "testuser@example.com",
  "password": "password123",
  "phone": "9876543210",
  "userStatus": 1
}</con:requestContent>
            </con:request>

            <con:assertions>
              <con:assertion type="Valid HTTP Status Codes"
                             name="Status Code 200">
                <con:configuration>
                  <codes>200</codes>
                </con:configuration>
              </con:assertion>
            </con:assertions>

          </con:restRequest>
        </con:config>
      </con:testStep>

      <con:testStep type="restrequest"
                    name="GET - Get User"
                    id="Step_Get_User">

        <con:settings/>

        <con:config xsi:type="con:RestTestRequestStep"
                    testCase="Petstore_User_TestCase"
                    testRequest="Get User">

          <con:restRequest name="GET - Get User">

            <con:settings/>

            <con:request>
              <con:settings/>
              <con:endpoint>https://petstore.swagger.io/v2</con:endpoint>
              <con:resourcePath>/user/testuser</con:resourcePath>

              <con:requestHeaders>
                <con:entry key="Accept" value="application/json"/>
              </con:requestHeaders>
            </con:request>

            <con:assertions>
              <con:assertion type="Valid HTTP Status Codes"
                             name="Status Code 200">
                <con:configuration>
                  <codes>200</codes>
                </con:configuration>
              </con:assertion>
            </con:assertions>

          </con:restRequest>
        </con:config>
      </con:testStep>

      <con:testStep type="restrequest"
                    name="GET - Login User"
                    id="Step_Login_User">

        <con:settings/>

        <con:config xsi:type="con:RestTestRequestStep"
                    testCase="Petstore_User_TestCase"
                    testRequest="Login User">

          <con:restRequest name="GET - Login User">

            <con:settings/>

            <con:request>
              <con:settings/>
              <con:endpoint>https://petstore.swagger.io/v2</con:endpoint>
              <con:resourcePath>/user/login</con:resourcePath>

              <con:parameters>
                <con:entry key="username" value="testuser"/>
                <con:entry key="password" value="password123"/>
              </con:parameters>

              <con:requestHeaders>
                <con:entry key="Accept" value="application/json"/>
              </con:requestHeaders>
            </con:request>

            <con:assertions>
              <con:assertion type="Valid HTTP Status Codes"
                             name="Status Code 200">
                <con:configuration>
                  <codes>200</codes>
                </con:configuration>
              </con:assertion>
            </con:assertions>

          </con:restRequest>
        </con:config>
      </con:testStep>

    </con:testCase>
  </con:testSuite>

</con:soapui-project>
