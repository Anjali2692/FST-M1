<?xml version="1.0" encoding="UTF-8"?>
<con:soapui-project xmlns:con="http://eviware.com/soapui/config"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    id="Calculator_XPath_Match_Project"
                    name="Calculator SOAP - XPath Match Activity"
                    soapui-version="5.7.0"
                    abortOnError="false"
                    runType="SEQUENTIAL">

  <con:settings/>

  <con:interface xsi:type="con:SoapHttpBinding"
                 id="Calculator_SOAP_Interface"
                 name="Calculator SOAP"
                 type="wsdl"
                 definition="https://www.dneonline.com/calculator.asmx?WSDL">

    <con:settings/>
    <con:definitionCache/>
    <con:endpoints>
      <con:endpoint>http://www.dneonline.com/calculator.asmx</con:endpoint>
    </con:endpoints>

    <con:operation name="Add"
                  id="Calculator_Add_Operation"
                  action="http://tempuri.org/Add"
                  type="Request-Response">

      <con:settings/>

      <con:call name="Add Request"
                id="Calculator_Add_Request">

        <con:settings/>

        <con:request>
          <con:settings/>

          <con:endpoint>http://www.dneonline.com/calculator.asmx</con:endpoint>

          <con:requestContent><![CDATA[
<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:tem="http://tempuri.org/">
  <soap:Header/>
  <soap:Body>
    <tem:Add>
      <tem:intA>10</tem:intA>
      <tem:intB>20</tem:intB>
    </tem:Add>
  </soap:Body>
</soap:Envelope>
]]></con:requestContent>

          <con:requestHeaders>
            <con:entry key="Content-Type" value="text/xml; charset=utf-8"/>
            <con:entry key="SOAPAction" value="&quot;http://tempuri.org/Add&quot;"/>
          </con:requestHeaders>

        </con:request>

        <con:assertions>

          <con:assertion type="XPath Match"
                         name="XPath Match - AddResult">

            <con:configuration>
              <path><![CDATA[
declare namespace ns1='http://tempuri.org/';
//ns1:AddResult
]]></path>

              <content>30</content>

              <allowWildcards>false</allowWildcards>
              <ignoreNamspaces>false</ignoreNamspaces>
              <useRegEx>false</useRegEx>
              <matchContent>true</matchContent>
              <mode>STRICT</mode>
            </con:configuration>

          </con:assertion>

        </con:assertions>

      </con:call>

    </con:operation>

  </con:interface>

  <con:testSuite id="Calculator_TestSuite"
                 name="Calculator XPath Match Test Suite">

    <con:settings/>
    <con:runType>SEQUENTIAL</con:runType>

    <con:testCase id="Calculator_XPath_TestCase"
                  name="Add - XPath Match Assertion"
                  failOnError="true"
                  failTestCaseOnErrors="true"
                  keepSession="false">

      <con:settings/>

      <con:testStep type="request"
                    name="Add Request"
                    id="Step_Add_Request">

        <con:settings/>

        <con:config xsi:type="con:RequestStep"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

          <con:request name="Add Request">
            <con:settings/>
            <con:endpoint>http://www.dneonline.com/calculator.asmx</con:endpoint>

            <con:requestContent><![CDATA[
<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:tem="http://tempuri.org/">
  <soap:Header/>
  <soap:Body>
    <tem:Add>
      <tem:intA>10</tem:intA>
      <tem:intB>20</tem:intB>
    </tem:Add>
  </soap:Body>
</soap:Envelope>
]]></con:requestContent>

            <con:requestHeaders>
              <con:entry key="Content-Type" value="text/xml; charset=utf-8"/>
              <con:entry key="SOAPAction" value="&quot;http://tempuri.org/Add&quot;"/>
            </con:requestHeaders>

          </con:request>
        </con:config>

      </con:testStep>

    </con:testCase>

  </con:testSuite>

</con:soapui-project>
